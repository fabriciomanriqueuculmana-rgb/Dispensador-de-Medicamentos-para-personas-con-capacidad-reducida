#include <Wire.h>
#include <RTClib.h>
#include <Servo.h>
#include <EEPROM.h>

// --- CONFIGURACIÓN GENERAL --------------------------------------------------
RTC_DS1307 rtc;

constexpr uint8_t SERVO1_PIN = 3;
constexpr uint8_t SERVO2_PIN = 5;
constexpr uint8_t SERVO3_PIN = 6;
constexpr uint8_t SENSOR_IR_PIN = 7;
constexpr uint8_t SENSOR_PIR_PIN = 8;
constexpr uint8_t BUZZER_PIN = 9;

constexpr uint8_t NUM_PASTILLAS = 3;
constexpr uint8_t MAX_EVENTOS = 3;

constexpr int SERVO_CERRADO = 0;
constexpr int SERVO_ABIERTO = 90;
constexpr unsigned long TIEMPO_SERVO_ABIERTO_MS = 1200;
constexpr unsigned long TIEMPO_ENTRE_PASTILLAS_MS = 800;
constexpr unsigned long INTERVALO_VERIFICACION_MS = 250;
constexpr unsigned long TIEMPO_MAX_ALARMA_MS = 15000UL; // ✅ 15 segundos

constexpr unsigned long NUNCA_DISPENSADO = 0xFFFFFFFFUL;

// --- ESTRUCTURA DE DATOS ----------------------------------------------------
struct EventoDispensacion {
  int hora;
  int minuto;
  uint8_t cantidad;
};

// --- DIRECCIONES EEPROM -----------------------------------------------------
int EEPROM_ADDR_P1 = 0;
int EEPROM_ADDR_P2 = EEPROM_ADDR_P1 + sizeof(EventoDispensacion) * MAX_EVENTOS;
int EEPROM_ADDR_P3 = EEPROM_ADDR_P2 + sizeof(EventoDispensacion) * MAX_EVENTOS;

// --- HORARIOS POR DEFECTO ---------------------------------------------------
EventoDispensacion horariosPastilla1[MAX_EVENTOS] = {
  {8, 0, 1},
  {20, 0, 2},
  {-1, -1, 0}
};

EventoDispensacion horariosPastilla2[MAX_EVENTOS] = {
  {14, 0, 1},
  {-1, -1, 0},
  {-1, -1, 0}
};

EventoDispensacion horariosPastilla3[MAX_EVENTOS] = {
  {14, 0, 1},
  {21, 0, 1},
  {-1, -1, 0}
};

Servo servos[NUM_PASTILLAS];
unsigned long ultimaDispensacion[NUM_PASTILLAS][MAX_EVENTOS];
bool yaDispensado[NUM_PASTILLAS] = {false, false, false};
bool bloqueoDispensacion = false;

uint8_t dispensacionesPendientes = 0;

// --- PROTOTIPOS -------------------------------------------------------------
void verificarPastilla(uint8_t indicePastilla, Servo &servo, EventoDispensacion horarios[], const DateTime &ahora);
void dispensarPastilla(uint8_t indicePastilla, Servo &servo, uint8_t cantidad);
void gestionarAlarma();
void activarAlarma();
void desactivarAlarma();
bool hayPastillaEnReceptaculo();
bool hayMovimientoPersona();
void mostrarHorarios();
void cambiarHorario();
void atenderComandosSerial();
EventoDispensacion *obtenerHorarios(uint8_t indicePastilla);
void limpiarBufferSerial();
void guardarHorariosEEPROM();
void cargarHorariosEEPROM();
bool datosEEPROMValidos();

// --- SETUP ------------------------------------------------------------------
void setup() {
  Serial.begin(9600);
  Wire.begin();
  rtc.begin();

  if (!rtc.isrunning()) {
    rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
    Serial.println("RTC configurado automáticamente.");
  }

  const uint8_t pinesServo[NUM_PASTILLAS] = {SERVO1_PIN, SERVO2_PIN, SERVO3_PIN};
  for (uint8_t i = 0; i < NUM_PASTILLAS; ++i) {
    servos[i].attach(pinesServo[i]);
    servos[i].write(SERVO_CERRADO);
    for (uint8_t j = 0; j < MAX_EVENTOS; ++j)
      ultimaDispensacion[i][j] = NUNCA_DISPENSADO;
  }

  pinMode(SENSOR_IR_PIN, INPUT);
  pinMode(SENSOR_PIR_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  if (datosEEPROMValidos()) {
    cargarHorariosEEPROM();
    Serial.println("📂 Horarios cargados desde EEPROM.");
  } else {
    guardarHorariosEEPROM();
  }

  mostrarHorarios();
}

// --- LOOP ------------------------------------------------------------------
void loop() {
  DateTime ahora = rtc.now();

  verificarPastilla(0, servos[0], horariosPastilla1, ahora);
  verificarPastilla(1, servos[1], horariosPastilla2, ahora);
  verificarPastilla(2, servos[2], horariosPastilla3, ahora);

  static unsigned long minutoAnterior = 0;
  unsigned long minutoActual = ahora.unixtime() / 60UL;

  if (minutoActual != minutoAnterior) {
    dispensacionesPendientes = 0;
    bloqueoDispensacion = false;
    for(uint8_t p=0; p<NUM_PASTILLAS; p++) yaDispensado[p] = false;
    minutoAnterior = minutoActual;
  }

  // calcular cuántas pastillas deberían dispensarse este minuto
  uint8_t totalProgramado = 0;
  for (uint8_t p = 0; p < NUM_PASTILLAS; p++) {
    EventoDispensacion *h = obtenerHorarios(p);
    for (uint8_t i = 0; i < MAX_EVENTOS; i++) {
      if (h[i].hora == ahora.hour() && h[i].minuto == ahora.minute())
        totalProgramado++;
    }
  }

  if (!bloqueoDispensacion && totalProgramado > 0 && dispensacionesPendientes == totalProgramado) {
    Serial.println("✅ Todas las pastillas dispensadas, iniciando alarma");
    bloqueoDispensacion = true;
    activarAlarma();
    gestionarAlarma();
  }

  atenderComandosSerial();
  delay(INTERVALO_VERIFICACION_MS);
}

// --- FUNCIONES PRINCIPALES --------------------------------------------------
void verificarPastilla(uint8_t indicePastilla, Servo &servo, EventoDispensacion horarios[], const DateTime &ahora) {

  if (bloqueoDispensacion) return;

  const unsigned long minutoActual = ahora.unixtime() / 60UL;

  // ✅ calcular totalProgramado dentro de esta función
  uint8_t totalProgramado = 0;
  for (uint8_t p = 0; p < NUM_PASTILLAS; p++) {
    EventoDispensacion *h = obtenerHorarios(p);
    for (uint8_t j = 0; j < MAX_EVENTOS; j++) {
      if (h[j].hora == ahora.hour() && h[j].minuto == ahora.minute())
        totalProgramado++;
    }
  }

  for (uint8_t i = 0; i < MAX_EVENTOS; ++i) {
    EventoDispensacion &ev = horarios[i];
    if (ev.hora < 0 || ev.minuto < 0 || ev.cantidad == 0) continue;

    if (ev.hora == ahora.hour() && ev.minuto == ahora.minute()) {

      // ✅ evitar doble dispensado
      if (ultimaDispensacion[indicePastilla][i] == minutoActual) return;
      if (yaDispensado[indicePastilla]) return;

      // ✅ registrar antes de dispensar
      ultimaDispensacion[indicePastilla][i] = minutoActual;
      yaDispensado[indicePastilla] = true;
      dispensacionesPendientes++;

      dispensarPastilla(indicePastilla, servo, ev.cantidad);

      // ✅ activar alarma inmediatamente cuando ya cayeron todas
      if (dispensacionesPendientes == totalProgramado) {
        Serial.println("✅ Todas las pastillas dispensadas, iniciando alarma");
        bloqueoDispensacion = true;
        activarAlarma();
        gestionarAlarma();
      }

      return;
    }
  }
}

void dispensarPastilla(uint8_t indicePastilla, Servo &servo, uint8_t cantidad) {
  Serial.print("Dispensando pastilla ");
  Serial.print(indicePastilla + 1);
  Serial.print(" -> ");
  Serial.print(cantidad);
  Serial.println(" unidades");

  for (uint8_t d = 0; d < cantidad; d++) {
    servo.write(SERVO_ABIERTO);
    delay(TIEMPO_SERVO_ABIERTO_MS);
    servo.write(SERVO_CERRADO);
    delay(TIEMPO_ENTRE_PASTILLAS_MS);
  }
}

// ✅ ALARMA COMPLETA
void gestionarAlarma() {
  unsigned long inicio = millis();

  while (millis() - inicio < TIEMPO_MAX_ALARMA_MS) {
    if (!hayPastillaEnReceptaculo()) {
      Serial.println("✅ Pastilla retirada - alarma OFF");
      desactivarAlarma();
      return;
    }
    delay(INTERVALO_VERIFICACION_MS);
  }

  desactivarAlarma();
  Serial.println("⏳ No retiró - esperando movimiento");

  while (true) {
    if (hayMovimientoPersona()) {
      Serial.println("👤 Movimiento detectado - reactivando alarma");
      activarAlarma();

      while (hayPastillaEnReceptaculo()) {
        delay(INTERVALO_VERIFICACION_MS);
      }

      desactivarAlarma();
      Serial.println("✅ Pastilla retirada tras movimiento");
      break;
    }
    delay(INTERVALO_VERIFICACION_MS);
  }
}

// --- ALARMA CONTROL ---------------------------------------------------------
void activarAlarma() { digitalWrite(BUZZER_PIN, HIGH); }
void desactivarAlarma() { digitalWrite(BUZZER_PIN, LOW); }
bool hayPastillaEnReceptaculo() { return digitalRead(SENSOR_IR_PIN) == LOW; }
bool hayMovimientoPersona() { return digitalRead(SENSOR_PIR_PIN) == HIGH; }

// --- MENÚ SERIAL ------------------------------------------------------------
void atenderComandosSerial() {
  if (Serial.available() == 0) return;

  int opcion = Serial.parseInt();

  switch (opcion) {
    case 1:
      mostrarHorarios();
      break;
    case 2:
      cambiarHorario();
      break;
    default:
      Serial.println("Comando no válido.");
      limpiarBufferSerial();
  }
}

// --- EEPROM ---------------------------------------------------------------
void guardarHorariosEEPROM() {
  EEPROM.put(EEPROM_ADDR_P1, horariosPastilla1);
  EEPROM.put(EEPROM_ADDR_P2, horariosPastilla2);
  EEPROM.put(EEPROM_ADDR_P3, horariosPastilla3);
  EEPROM.put(300, 0xBEEF);
  Serial.println("💾 Horarios guardados en EEPROM.");
}

void cargarHorariosEEPROM() {
  EEPROM.get(EEPROM_ADDR_P1, horariosPastilla1);
  EEPROM.get(EEPROM_ADDR_P2, horariosPastilla2);
  EEPROM.get(EEPROM_ADDR_P3, horariosPastilla3);
}

bool datosEEPROMValidos() {
  int marcador;
  EEPROM.get(300, marcador);
  return (marcador == 0xBEEF);
}

void mostrarHorarios() {
  Serial.println("=== HORARIOS ACTUALES ===");
  for (uint8_t p = 0; p < NUM_PASTILLAS; p++) {
    EventoDispensacion *h = obtenerHorarios(p);
    Serial.print("Pastilla "); Serial.println(p + 1);

    for (uint8_t i = 0; i < MAX_EVENTOS; i++) {
      if (h[i].hora >= 0) {
        Serial.print("  - ");
        Serial.print(h[i].hora);
        Serial.print(":");
        if (h[i].minuto < 10) Serial.print("0");
        Serial.print(h[i].minuto);
        Serial.print(" -> ");
        Serial.print(h[i].cantidad);
        Serial.println(" u");
      } else {
        Serial.println("  - (libre)");
      }
    }
  }
}

void cambiarHorario() {
  Serial.println("Formato: pastilla indice hora minuto cantidad");
  while (Serial.available() == 0);

  int past = Serial.parseInt();
  int idx = Serial.parseInt();
  int h = Serial.parseInt();
  int m = Serial.parseInt();
  int c = Serial.parseInt();

  if (past < 1 || past > 3 || idx < 0 || idx > 2) {
    Serial.println("Parámetros inválidos.");
    limpiarBufferSerial();
    return;
  }

  EventoDispensacion *tabla = obtenerHorarios(past - 1);
  EventoDispensacion &ev = tabla[idx];

  if (h < 0 || m < 0 || c <= 0) {
    ev.hora = -1; ev.minuto = -1; ev.cantidad = 0;
    Serial.println("Horario eliminado.");
  } else {
    ev.hora = constrain(h, 0, 23);
    ev.minuto = constrain(m, 0, 59);
    ev.cantidad = constrain(c, 1, 10);
    Serial.println("Horario actualizado.");
  }

  ultimaDispensacion[past - 1][idx] = NUNCA_DISPENSADO;
  guardarHorariosEEPROM();
  mostrarHorarios();
  limpiarBufferSerial();
}

// --- AUXILIARES ------------------------------------------------------------
EventoDispensacion *obtenerHorarios(uint8_t indicePastilla) {
  switch (indicePastilla) {
    case 0: return horariosPastilla1;
    case 1: return horariosPastilla2;
    default: return horariosPastilla3;
  }
}

void limpiarBufferSerial() {
  while (Serial.available()) Serial.read();
}
