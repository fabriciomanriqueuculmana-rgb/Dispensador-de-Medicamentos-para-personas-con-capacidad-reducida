#include <Wire.h>        // Librería para comunicación I2C (necesaria para el RTC)
#include <RTClib.h>      // Librería para manejar el reloj en tiempo real (RTC DS1307)
#include <Servo.h>       // Librería para controlar los servomotores

RTC_DS1307 rtc;          // Creación del objeto del reloj DS1307

// --- DECLARACIÓN DE SERVOS ---
Servo servo1, servo2, servo3;   // Tres servos para tres dispensadores distintos
#define SERVO1_PIN 3
#define SERVO2_PIN 5
#define SERVO3_PIN 6

// --- DECLARACIÓN DE SENSORES ---
#define SENSOR_IR 7   // Sensor infrarrojo que detecta si la pastilla cayó en el receptáculo
#define SENSOR_PIR 8  // Sensor PIR que detecta movimiento de la persona
#define BUZZER 9      // Buzzer para la alarma sonora

// --- CONFIGURACIÓN DE HORARIOS Y CANTIDADES ---
// Se definen hasta 3 horarios diferentes por tipo de pastilla
// Un valor de -1 indica que ese horario no está en uso

// Pastilla 1: se toma a las 8:00 (1 unidad) y 20:00 (2 unidades)
int horas1[3]    = {8, 20, -1};
int minutos1[3]  = {0, 0, -1};
int cantidad1[3] = {1, 2, -1};

// Pastilla 2: se toma a las 14:00 (1 unidad)
int horas2[3]    = {14, -1, -1};
int minutos2[3]  = {0, -1, -1};
int cantidad2[3] = {1, -1, -1};

// Pastilla 3: se toma a las 14:00 (1 unidad) y 21:00 (1 unidad)
int horas3[3]    = {14, 21, -1};
int minutos3[3]  = {0, 0, -1};
int cantidad3[3] = {1, 1, -1};

// --- VARIABLES DE CONTROL ---
bool alarmaActiva = false;           // Indica si la alarma está encendida
unsigned long tiempoInicioAlarma = 0; // Guarda el tiempo en que se activó la alarma

// --- CONFIGURACIÓN INICIAL ---
void setup() {
  Serial.begin(9600);  // Comunicación serial para mostrar mensajes o recibir comandos
  Wire.begin();        // Inicia la comunicación I2C
  rtc.begin();         // Inicializa el módulo RTC

  // Asignar los pines a cada servo
  servo1.attach(SERVO1_PIN);
  servo2.attach(SERVO2_PIN);
  servo3.attach(SERVO3_PIN);

  // Configuración de pines
  pinMode(SENSOR_IR, INPUT);
  pinMode(SENSOR_PIR, INPUT);
  pinMode(BUZZER, OUTPUT);
  digitalWrite(BUZZER, LOW); // Asegura que el buzzer esté apagado al inicio

  // Si el RTC no está configurado, se ajusta automáticamente a la hora de compilación
  if (!rtc.isrunning()) {
    Serial.println("RTC not set, setting current time...");
    rtc.adjust(DateTime(F(__DATE__), F(__TIME__))); // Ajuste automático
  }

  // Mensajes de bienvenida y menú
  Serial.println("=== DISPENSADOR DE MEDICAMENTOS ===");
  Serial.println("Comandos disponibles:");
  Serial.println("1: Ver horarios");
  Serial.println("2: Cambiar horario (pastilla, indice, hora, minuto, cantidad)");
}

// --- BUCLE PRINCIPAL ---
void loop() {
  DateTime now = rtc.now(); // Obtiene la hora actual

  // Verifica los horarios de cada tipo de pastilla
  verificarPastilla(1, servo1, horas1, minutos1, cantidad1);
  verificarPastilla(2, servo2, horas2, minutos2, cantidad2);
  verificarPastilla(3, servo3, horas3, minutos3, cantidad3);

  // Escucha comandos desde el monitor serial
  if (Serial.available()) {
    int opcion = Serial.parseInt();
    if (opcion == 1) mostrarHorarios();  // Muestra los horarios actuales
    if (opcion == 2) cambiarHorario();   // Permite cambiar un horario
  }

  delay(1000); // Espera 1 segundo antes de volver a verificar
}

// --- FUNCIÓN PARA VERIFICAR SI ES HORA DE DISPENSAR ---
void verificarPastilla(int id, Servo &servo, int horasPastilla[], int minutosPastilla[], int cantidadPastilla[]) {
  DateTime now = rtc.now();
  int hora = now.hour();
  int minuto = now.minute();

  // Recorre los 3 posibles horarios de cada pastilla
  for (int i = 0; i < 3; i++) {
    if (horasPastilla[i] == -1 || minutosPastilla[i] == -1) continue; // Ignora los vacíos
    if (hora == horasPastilla[i] && minuto == minutosPastilla[i]) {   // Coincide la hora y minuto
      dispensar(servo, id, cantidadPastilla[i]);  // Activa el dispensador
      delay(60000); // Espera 1 minuto para evitar que se repita la acción
    }
  }
}

// --- FUNCIÓN PARA DISPENSAR LAS PASTILLAS ---
void dispensar(Servo &servo, int id, int cantidad) {
  Serial.print("Dispensando pastilla "); Serial.print(id);
  Serial.print(" ("); Serial.print(cantidad); Serial.println(" unidad/es)");

  // Gira el servo según la cantidad de pastillas a soltar
  for (int i = 0; i < cantidad; i++) {
    servo.write(90);  // Abre el compartimento
    delay(1000);
    servo.write(0);   // Cierra
    delay(1000);
  }

  activarAlarma();  // Activa la alarma sonora

  unsigned long inicio = millis(); // Guarda el tiempo de inicio
  // Espera hasta 5 minutos para verificar si la pastilla fue tomada
  while (millis() - inicio < 300000) { // 5 minutos = 300000 ms
    if (!digitalRead(SENSOR_IR)) {     // Si el IR detecta que no hay pastilla (fue tomada)
      Serial.println("Pastilla tomada correctamente.");
      desactivarAlarma();              // Apaga la alarma
      return;
    }
  }

  // Si no se tomó la pastilla en 5 minutos
  Serial.println("No se tomó en 5 min. Esperando movimiento...");
  desactivarAlarma(); // Apaga la alarma por ahora

  // Espera hasta que el PIR detecte movimiento
  while (true) {
    if (digitalRead(SENSOR_PIR)) {
      Serial.println("Movimiento detectado. Reanudando alarma.");
      activarAlarma(); // Reactiva alarma
      while (digitalRead(SENSOR_IR)) {} // Espera hasta que el IR confirme que la pastilla fue tomada
      desactivarAlarma();
      break;
    }
  }
}

// --- FUNCIÓN PARA ACTIVAR LA ALARMA ---
void activarAlarma() {
  alarmaActiva = true;
  tiempoInicioAlarma = millis();
  digitalWrite(BUZZER, HIGH); // Enciende buzzer
}

// --- FUNCIÓN PARA DESACTIVAR LA ALARMA ---
void desactivarAlarma() {
  alarmaActiva = false;
  digitalWrite(BUZZER, LOW); // Apaga buzzer
}

// --- FUNCIÓN PARA MOSTRAR LOS HORARIOS CONFIGURADOS ---
void mostrarHorarios() {
  Serial.println("Horarios actuales:");
  for (int i = 0; i < 3; i++) {
    if (horas1[i] != -1)
      Serial.print("Pastilla 1 -> "), Serial.print(horas1[i]), Serial.print(":"), Serial.print(minutos1[i]), Serial.print("  Cantidad: "), Serial.println(cantidad1[i]);
    if (horas2[i] != -1)
      Serial.print("Pastilla 2 -> "), Serial.print(horas2[i]), Serial.print(":"), Serial.print(minutos2[i]), Serial.print("  Cantidad: "), Serial.println(cantidad2[i]);
    if (horas3[i] != -1)
      Serial.print("Pastilla 3 -> "), Serial.print(horas3[i]), Serial.print(":"), Serial.print(minutos3[i]), Serial.print("  Cantidad: "), Serial.println(cantidad3[i]);
  }
}

// --- FUNCIÓN PARA CAMBIAR UN HORARIO DESDE EL MONITOR SERIAL ---
void cambiarHorario() {
  Serial.println("Ingrese: <pastilla> <indice 0-2> <hora> <minuto> <cantidad>");
  while (Serial.available() == 0); // Espera a que se ingrese el comando
  int p = Serial.parseInt();  // Número de pastilla
  int i = Serial.parseInt();  // Índice (posición del horario)
  int h = Serial.parseInt();  // Hora nueva
  int m = Serial.parseInt();  // Minuto nuevo
  int c = Serial.parseInt();  // Cantidad nueva

  // Actualiza el horario según el número de pastilla
  if (p == 1) { horas1[i] = h; minutos1[i] = m; cantidad1[i] = c; }
  if (p == 2) { horas2[i] = h; minutos2[i] = m; cantidad2[i] = c; }
  if (p == 3) { horas3[i] = h; minutos3[i] = m; cantidad3[i] = c; }

  Serial.print("Horario actualizado para pastilla "); Serial.println(p);
  mostrarHorarios(); // Muestra los nuevos horarios actualizados
}
